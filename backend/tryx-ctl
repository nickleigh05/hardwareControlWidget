#!/usr/bin/env bash
# Validated wrapper around reed-tpse (TRYX Panorama SE) for UIs.
#
#   tryx-ctl state                      JSON: media on device, current selection, brightness, daemon status
#   tryx-ctl info                       device info (text)
#   tryx-ctl brightness N               0-100
#   tryx-ctl display N RATIO FILE...    RATIO 2:1 (one wide/full image) or 1:1 (two images, left+right); brightness N
#   tryx-ctl thumbs                     generate preview JPGs for media on the device (cached)
#   tryx-ctl upload FILE                copy a local image/video/gif to the device (gif -> mp4)
#   tryx-ctl delete FILE...             delete media from the device
#   tryx-ctl daemon-status|daemon-start|daemon-stop
#
#   tryx-ctl sync                       sync the drop folder to the cooler (see tryx-sync); one JSON line
#   tryx-ctl dropdir                    print the drop folder path
#
# Env: REED_TPSE_BIN (default: reed-tpse from PATH or ~/.local/bin), TRYX_MEDIA_DIR (drop folder)
set -euo pipefail
# Hosts (e.g. a Quickshell) often launch us with a PATH lacking ~/.local/bin, where reed-tpse lives.
# Without this, bash falls back to a relative path and can hit a *directory* named reed-tpse in $HOME.
export PATH="$HOME/.local/bin:$PATH"
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
BIN="${REED_TPSE_BIN:-$(command -v reed-tpse || true)}"
[[ -n "$BIN" && -x "$BIN" && ! -d "$BIN" ]] || { echo "tryx-ctl: reed-tpse not found (see patches/ and README)" >&2; exit 127; }
die() { echo "tryx-ctl: $*" >&2; exit 2; }

# Serial port: pass it explicitly. reed-tpse's auto-detect handshake fails while the
# keepalive daemon holds the port. Override with TRYX_PORT.
port() {
  if [[ -n "${TRYX_PORT:-}" ]]; then echo "$TRYX_PORT"; return; fi
  local p; for p in /dev/ttyACM*; do [[ -e "$p" ]] && { echo "$p"; return; }; done
  die "no /dev/ttyACM* device (is the cooler connected, and are you in the uucp group?)"
}

# Remote media names: plain filenames only (no path, no leading dash, no control chars).
names() {
  [[ $# -gt 0 ]] || die "need a file name"
  local n
  for n in "$@"; do
    [[ "$n" =~ ^[A-Za-z0-9._][A-Za-z0-9._\ ()+,-]*$ && "$n" != *..* ]] || die "bad file name: $n"
  done
}
pct() { [[ "${1:-}" =~ ^[0-9]{1,3}$ ]] && (( $1 <= 100 )) || die "brightness must be 0-100"; }

cmd="${1:-}"; shift || true
case "$cmd" in
  state)
    files="$(adb shell ls -1 /sdcard/pcMedia/ 2>/dev/null | tr -d '\r' || true)"
    daemon="$(systemctl --user is-active reed-tpse.service 2>/dev/null || true)"
    stf="${XDG_STATE_HOME:-$HOME/.local/state}/reed-tpse/display.json"
    dropdir="$(python3 -I "$here/tryx-sync" dir 2>/dev/null || true)"
    FILES="$files" DAEMON="${daemon:-unknown}" STF="$stf" DROPDIR="$dropdir" python3 -I -c '
import os, json
files = [f for f in os.environ["FILES"].split("\n") if f.strip()]
owned = []
try:
    mf = json.load(open(os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "rgb-display-widget", "sync.json")))
    owned = sorted({e["dev"] for e in mf.values()})
except Exception: pass
cur, bright, ratio = [], None, "2:1"
try:
    st = json.load(open(os.environ["STF"])); cur = st.get("media", []); bright = st.get("brightness"); ratio = st.get("ratio", "2:1")
except Exception: pass
tdir = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "rgb-display-widget", "thumbs")
print(json.dumps({"connected": bool(files) or os.path.exists("/dev/ttyACM0"), "files": files, "current": cur, "ratio": ratio,
                  "brightness": bright, "daemon": os.environ["DAEMON"], "thumbDir": tdir, "dropDir": os.environ.get("DROPDIR", ""), "owned": owned}))'
    ;;
  sync) exec python3 -I "$here/tryx-sync" sync ;;
  dropdir) exec python3 -I "$here/tryx-sync" dir ;;
  info) exec "$BIN" -p "$(port)" info ;;
  brightness) pct "${1:-}"; exec "$BIN" -p "$(port)" brightness "$1" ;;
  display)
    pct "${1:-}"; b="$1"; shift
    r="${1:-}"; [[ "$r" == "2:1" || "$r" == "1:1" ]] || die "ratio must be 2:1 or 1:1"; shift
    names "$@"
    # reed-tpse rewrites .gif -> .mp4 when displaying, but only `upload` converts. Showing a raw
    # .gif on the device would point at a file that doesn't exist (blank screen).
    for n in "$@"; do [[ "${n,,}" == *.gif ]] && die "GIFs can't be displayed directly; convert to MP4 first (tryx-ctl upload converts)"; done
    exec "$BIN" -p "$(port)" display "$@" --mode full --ratio "$r" --brightness "$b"
    ;;
  thumbs)
    dir="${XDG_CACHE_HOME:-$HOME/.cache}/rgb-display-widget/thumbs"; mkdir -p "$dir"
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
    adb shell ls -1 /sdcard/pcMedia/ 2>/dev/null | tr -d '\r' | while IFS= read -r f; do
      [[ -n "$f" ]] || continue
      names "$f" 2>/dev/null || continue
      [[ -s "$dir/$f.jpg" ]] && continue
      adb pull "/sdcard/pcMedia/$f" "$tmp/$f" >/dev/null 2>&1 || continue
      ffmpeg -v error -y -i "$tmp/$f" -ss 0 -frames:v 1 -vf "scale=320:-2" "$dir/$f.jpg" </dev/null 2>/dev/null || ffmpeg -v error -y -i "$tmp/$f" -frames:v 1 -vf "scale=320:-2" "$dir/$f.jpg" </dev/null 2>/dev/null || true
      rm -f "$tmp/$f"
    done
    echo "$dir"
    ;;
  upload)
    [[ -f "${1:-}" ]] || die "no such file"
    f="$1"; [[ "$f" == -* ]] && f="./$f"
    exec "$BIN" upload "$f"
    ;;
  delete)
    names "$@"
    manifest="${XDG_CACHE_HOME:-$HOME/.cache}/rgb-display-widget/sync.json"
    for n in "$@"; do
      if [[ -f "$manifest" ]] && N="$n" python3 -I -c 'import json,os,sys; sys.exit(0 if os.environ["N"] in {e["dev"] for e in json.load(open(sys.argv[1])).values()} else 1)' "$manifest" 2>/dev/null; then
        die "$n came from your drop folder; delete it there instead"
      fi
    done
    "$BIN" delete "$@"
    for n in "$@"; do rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/rgb-display-widget/thumbs/$n.jpg"; done
    ;;
  daemon-status) exec "$BIN" daemon status ;;
  daemon-start)  exec "$BIN" daemon start ;;
  daemon-stop)   exec "$BIN" daemon stop ;;
  *) die "usage: state|info|brightness N|display N FILE...|upload FILE|delete FILE...|daemon-status|daemon-start|daemon-stop" ;;
esac
