#!/usr/bin/env bash
# Thin, validated wrapper around OpenRGB's CLI for UIs.
#
#   rgb-ctl state                          JSON: devices, their modes, current mode
#   rgb-ctl apply DEV MODE COLOR BRIGHT    DEV = index|all|i,j,k ; MODE/COLOR/BRIGHT = value or "-" to skip
#   rgb-ctl profiles | profile NAME
#
# Uses a running `openrgb --server` (fast, no hardware re-probe) when one is
# listening on 127.0.0.1:6742, otherwise falls back to standalone mode (~1.5s/call).
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"

OR="${OPENRGB_BIN:-openrgb}"
HOST=127.0.0.1; PORT="${OPENRGB_PORT:-6742}"

if (exec 3<>"/dev/tcp/$HOST/$PORT") 2>/dev/null; then
  CONN=(--client "$HOST:$PORT")
else
  CONN=(--noautoconnect)
fi

die() { echo "rgb-ctl: $*" >&2; exit 2; }

cmd="${1:-}"; shift || true
case "$cmd" in
  state)
    "$OR" "${CONN[@]}" -ld 2>/dev/null | python3 -I -c '
import sys, re, json, shlex
devs, cur = [], None
for line in sys.stdin:
    line = line.rstrip("\n")
    m = re.match(r"^(\d+): (.+)$", line)
    if m:
        cur = {"index": int(m.group(1)), "name": m.group(2), "type": "", "modes": [], "current": "", "zones": []}
        devs.append(cur); continue
    if cur is None: continue
    s = line.strip()
    if s.startswith("Type:"): cur["type"] = s.split(":", 1)[1].strip()
    elif s.startswith("Modes:"):
        for tok in shlex.split(s.split(":", 1)[1]):
            if tok.startswith("[") and tok.endswith("]"):
                tok = tok[1:-1]; cur["current"] = tok
            cur["modes"].append(tok)
    elif s.startswith("Zones:"):
        cur["zones"] = shlex.split(s.split(":", 1)[1])
print(json.dumps(devs))'
    ;;

  apply)
    dev="${1:-}"; mode="${2:--}"; color="${3:--}"; bright="${4:--}"
    # DEV: "all", one index, or a comma list like 0,1,3
    [[ "$dev" == "all" || "$dev" =~ ^[0-9]+(,[0-9]+)*$ ]] || die "bad device"
    opts=()
    if [[ "$mode" != "-" ]]; then
      [[ "$mode" =~ ^[A-Za-z0-9\ _-]+$ ]] || die "bad mode"
      opts+=(-m "$mode")
    elif [[ "$color" != "-" ]]; then
      opts+=(-m static)
    fi
    if [[ "$color" != "-" ]]; then
      [[ "$color" =~ ^[0-9A-Fa-f]{6}$ ]] || die "color must be RRGGBB"
      opts+=(-c "$color")
    fi
    if [[ "$bright" != "-" ]]; then
      [[ "$bright" =~ ^[0-9]{1,3}$ ]] && (( bright <= 100 )) || die "brightness 0-100"
      opts+=(-b "$bright")
    fi
    [[ ${#opts[@]} -gt 0 ]] || die "nothing to apply"
    args=()
    if [[ "$dev" == "all" ]]; then
      args=("${opts[@]}")
    else
      IFS=, read -ra ids <<< "$dev"
      for id in "${ids[@]}"; do args+=(-d "$id" "${opts[@]}"); done
    fi
    exec "$OR" "${CONN[@]}" "${args[@]}"
    ;;

  profiles)
    ls -1 "${XDG_CONFIG_HOME:-$HOME/.config}/OpenRGB/"*.orp 2>/dev/null | xargs -rn1 basename | sed 's/\.orp$//' || true
    ;;
  profile)
    [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]] || die "bad profile name"
    exec "$OR" "${CONN[@]}" -p "$1"
    ;;
  *) die "usage: state | apply DEV MODE COLOR BRIGHT | profiles | profile NAME" ;;
esac
